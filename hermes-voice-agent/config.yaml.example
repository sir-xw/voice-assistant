voice:
  user_title: "主人"  # 语音助手对用户的称呼

  wake_word:
    enabled: true
    engine: "sherpa-onnx"
    threshold: 0.25
    score: 1.0
    model:
      dir: "models/sherpa-kws"
      name: "sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20"
      encoder: "encoder-epoch-13-avg-2-chunk-8-left-64.int8.onnx"
      decoder: "decoder-epoch-13-avg-2-chunk-8-left-64.onnx"
      joiner: "joiner-epoch-13-avg-2-chunk-8-left-64.int8.onnx"
      tokens: "tokens.txt"

  vad:
    engine: "webrtc"
    mode: 3
    min_speech_ms: 200
    silence_threshold_ms: 1000
    speech_confirm_frames: 3
    # 唤醒词命中后的静音保护期（秒）：该时段内不应用静音超时。
    # 唤醒瞬间提示音回声/唤醒词尾音会让 VAD 短暂激活，随即静音超时导致
    # ASR 过早结束（final 为空）。保护期内静音只送帧不结束，等用户真正开口。
    wake_guard_sec: 2.5

  # 麦克风采集采样率：0=自动探测设备支持的采样率（默认），非 0 强制指定。
  # 某些 USB 麦克风（如 AIMIC-M4）只支持 48000Hz，采集后内部会重采样到 16kHz
  mic_sample_rate: 0

  # 麦克风采集设备：auto=自动（默认，优先 pipewire/pulse，确保与音频栈一致），
  # 也可指定设备索引或名称（如 "pulse" / "AIMIC-M4"）
  mic_device: auto

  asr:
    engine_model: "16k_zh_en_speaker_2.0"
    needvad: true
    voice_format: 1

  tts:
    enabled: true
    engine: "tencent-cloud"
    voice_type: 601009
    codec: "pcm"
    sample_rate: 16000
    speed: 0.0
    volume: 10.0

  # 多 AI Agent 实例，每个由不同唤醒词触发
  # keywords：该 agent 的全部唤醒词（列表形式），任一个命中都会触发该 agent；
  #           keywords.txt 中 @ 后面的原文统一为 agent 的 name；不配置时回退为 [name]。
  #           tools/gen_keywords.py 会读取本配置自动更新 raw_keywords.txt / keywords.txt
  # api_mode：API 模式（如 codex_responses / chat_completions）；base_url：API 端点
  agents:
    - name: "小布"
      keywords:
        - "小布小布"
      model: "deepseek-v4-flash"
      provider: "deepseek"
      api_mode: "codex_responses"
      base_url: "https://api.deepseek.com"
      max_iterations: 30
      session_id: "hermes-voice-session"
      system_prompt: |
        本轮会话中，你不能执行任何会影响系统稳定运行或改变系统关键设置的指令。

    # - name: "翻译助手"
    #   keywords:
    #     - "翻译助手"
    #   model: "openai/gpt-4o-mini"
    #   max_iterations: 10
    #   session_id: "translator-session"
    #   system_prompt: |
    #     你是一个翻译助手。将用户的输入翻译成英文。

  conversation_window:
    timeout_sec: 5.0

  # 说话人识别（可选）：
  # 每完成一个腾讯云句子，本地 CAM++ 提取声纹与特征库对照，识别说话人并写入日志；
  # 发送给 LLM 的消息会带上 [说话人身份] 前缀（格式说明已写入预设 system prompt）。
  # 新说话人自动分配 spk_100 起的默认 id 并注册入库；管理员可在 speaker_names
  # 中把默认 id 映射为真实身份（如 "spk_100": "爸爸"），重启后日志与消息显示真实名字。
  # 注意：说话人分离引擎（16k_zh_en_speaker_2.0）与腾讯云情绪识别互斥，故无情绪字段。
  voiceprint:
    enabled: true
    threshold: 0.6            # 声纹匹配阈值，低于此值视为新说话人
    lib_dir: "models/voiceprint_lib"
    auto_register: true       # 识别到新说话人自动分配 id 并注册
    min_register_sec: 1.5     # 注册用最短句子时长（过短不入库，避免劣质声纹）
    speaker_id_cache: true    # 同一会话同一 speaker_id 只识别一次（低延迟）
    # 管理员身份映射示例（部署时按需填写真实身份，重启后生效）：
    # speaker_names:
    #   spk_100: "爸爸"
    #   spk_101: "妈妈"
