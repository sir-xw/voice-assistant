*.pyc
.env
*.log
*.wav
.reasonix

# —— 新三包（独立可安装子项目） ——
.venvs/
__pycache__/
*.egg-info/
build/
dist/
# 子项目运行数据（不入库，部署时提供）
voice_service/.env
voice_service/models/
# 对话历史日志（chat-YYYY-MM-DD.log，含家庭对话原文，绝不入库）
voice_service/logs/
# 本机部署配置（机器相关值）不入库；模板见 config.yaml.example
voice_service/config.yaml
# 包内提示音资产需要入库（豁免上面的 *.wav）
!voice_service/voice_service/assets/*.wav
# 测试素材：4spk.wav（多说话人分离对比）需要入库；测试运行时生成的声纹库忽略
!voice_service/tests/4spk.wav
voice_service/tests/voiceprint_lib/
voice_service/tests/voiceprint_sim_lib/
